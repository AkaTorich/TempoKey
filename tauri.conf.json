{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TempoKey",
  "mainBinaryName": "TempoKey",
  "version": "1.0.0",
  "identifier": "top.globthe.tempokey",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TempoKey — BPM & Key Detector",
        "width": 1240,
        "height": 780,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0a0c1b",
        "shadow": false,
        "resizable": true,
        "dragDropEnabled": true,
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "title": "TempoKey",
        "width": 600,
        "height": 340,
        "center": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0a0c1b",
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Music",
    "shortDescription": "BPM and musical key detection for audio tracks",
    "copyright": "O.V.K",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    }
  }
}
